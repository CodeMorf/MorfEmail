# Polar uses the sandbox by default during local development.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Use the public product IDs copied from the Polar dashboard.
POLAR_PRODUCT_STARTER_ID=
POLAR_PRODUCT_PRO_ID=
POLAR_PRODUCT_BUSINESS_ID=
POLAR_PRODUCT_ENTERPRISE_ID=

# URL used as Polar checkout return/success URL.
MORFEMAIL_APP_URL=http://127.0.0.1:3000
MORFEMAIL_API_PORT=3100
VITE_MORFEMAIL_LICENSE_API_URL=https://codemorf.tech/api/public/licenses/verify
# Public key used to verify the short-lived offline-grace token returned by CodeMorf.
VITE_MORFEMAIL_LICENSE_PUBLIC_KEY=
